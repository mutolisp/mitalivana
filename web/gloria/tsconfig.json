{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable", "WebWorker"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "types": ["vite/client", "node"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["../../mobile/app/src/*"],
      "@web/*": ["./src/*"],
      "@op-engineering/op-sqlite": ["./src/host/opSqlite.ts"],
      "expo-file-system": ["./src/host/expoFs.ts"],
      "expo-router": ["./src/host/expoRouter.ts"],
      "nativewind": ["./src/host/nativewind.ts"]
    }
  },
  "include": ["src", "test", "vite", "vite.config.ts", "src/globals.d.ts"]
}
